<Project>
  <PropertyGroup>
    <!-- Single source of truth for the paired Engine SDK. The product project,
         the focused managed checks under tests/, and .github/workflows/verify.yml
         all read this value, so bumping the pair cannot leave one of them behind.
         Update it together with the runtime pack under
         .runtime/pair-<revision>/ as AGENTS.md requires. -->
    <RustyEngineSdkPackageVersion>0.1.0-dev.9c8c9585ec52</RustyEngineSdkPackageVersion>
  </PropertyGroup>
</Project>
