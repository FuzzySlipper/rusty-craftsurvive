{
  "project": "rusty-craftsurvive",
  "serve": {
    "command": "PATH=\"$HOME/.local/bin:$PATH\" CRAFT_FOREST_STUDY=dense exec rusty dev --project ./src/CraftSurvive.Game/CraftSurvive.Game.csproj --live-debug --bind-host {host} --port {port} --diagnostics-log {session_dir}/rusty-engine-diagnostics.ndjson",
    "instanceArgs": "--instance {instance} --label {label}",
    "keepArgs": "--keep",
    "stopCommand": "PATH=\"$HOME/.local/bin:$PATH\" rusty dev stop --project ./src/CraftSurvive.Game/CraftSurvive.Game.csproj --instance {instance}",
    "healthUrl": "/product-ui/main.js",
    "readyText": "Rusty CraftSurvive",
    "reusePolicy": "broker_owned",
    "startupTimeout": "120s",
    "healthInterval": "250ms"
  }
}
