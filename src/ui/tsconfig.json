{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "generated/source",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
