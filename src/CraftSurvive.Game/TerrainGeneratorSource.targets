<Project>
  <!--
    The chunk cache must never serve a chunk generated by different generator code. Sampling the
    generator's output (TerrainGenerationFingerprint) catches changes near the probe and in the
    Engine's keyed draws; this stamp catches every change to the code that produces or encodes a
    chunk, wherever in the world it shows. It hashes the listed sources at build time, sorted by
    path and with line endings normalised, into TerrainGeneratorSource.Stamp below obj/.
  -->
  <ItemGroup>
    <TerrainGeneratorSource Include="Modules/WorldGen/**/*.cs" />
    <TerrainGeneratorSource Include="Modules/Content/**/*.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/TerrainChunk.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/TerrainChunkCache.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/TerrainConstants.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/TerrainConfiguration.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/TerrainOverlayState.cs" />
    <TerrainGeneratorSource Include="Modules/Terrain/VoxelAddress.cs" />
  </ItemGroup>

  <UsingTask TaskName="StampTerrainGeneratorSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Stamp ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using var sha = SHA256.Create();
        foreach (var item in Files.OrderBy(f => f.ItemSpec.Replace('\\', '/'), StringComparer.Ordinal))
        {
            string text = File.ReadAllText(item.GetMetadata("FullPath")).Replace("\r\n", "\n");
            byte[] entry = Encoding.UTF8.GetBytes(item.ItemSpec.Replace('\\', '/') + "\n" + text + "\n");
            sha.TransformBlock(entry, 0, entry.Length, null, 0);
        }

        sha.TransformFinalBlock(Array.Empty<byte>(), 0, 0);
        Stamp = string.Concat(sha.Hash.Take(8).Select(b => b.ToString("x2")));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StampTerrainGeneratorSource" BeforeTargets="CoreCompile">
    <StampTerrainGeneratorSource Files="@(TerrainGeneratorSource)">
      <Output TaskParameter="Stamp" PropertyName="TerrainGeneratorSourceStamp" />
    </StampTerrainGeneratorSource>
    <PropertyGroup>
      <TerrainGeneratorSourceFile>$(IntermediateOutputPath)TerrainGeneratorSource.g.cs</TerrainGeneratorSourceFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(TerrainGeneratorSourceFile)"
      Lines="namespace CraftSurvive.Game.Modules.Terrain%3B;internal static class TerrainGeneratorSource;{;    /// &lt;summary&gt;A hash of the generator's sources at build time%3B see TerrainGeneratorSource.targets.&lt;/summary&gt;;    internal const ulong Stamp = 0x$(TerrainGeneratorSourceStamp)UL%3B;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(TerrainGeneratorSourceFile)" />
      <FileWrites Include="$(TerrainGeneratorSourceFile)" />
    </ItemGroup>
  </Target>
</Project>
