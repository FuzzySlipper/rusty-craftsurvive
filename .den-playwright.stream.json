{
  "project": "rusty-craftsurvive",
  "serve": {
    "command": "bash scripts/serve-den.sh -- --host {host} --port {port}",
    "preferredPort": 0,
    "healthUrl": "/health",
    "readyText": "\"project\":\"rusty-craftsurvive\"",
    "identityHeader": "X-Den-Project",
    "reusePolicy": "broker_owned",
    "startupTimeout": "180s"
  },
  "tests": {
    "command": "pnpm smoke:streaming",
    "artifactPolicy": "live-ui"
  },
  "playtest": {
    "startPath": "/?course=stream",
    "viewport": { "width": 1280, "height": 720 },
    "headed": false,
    "recordVideo": true
  }
}
