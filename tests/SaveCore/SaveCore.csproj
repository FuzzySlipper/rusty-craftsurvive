<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- The save manifest, the shared envelope, the restore rule and every codec are pure product
         code over the Engine's codec shape, so they are checked without a runtime. -->
    <Compile Include="$(ProductModules)World/WorldMapSave.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/SaveManifest.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/SaveEnvelope.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/SaveRestore.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)WorldGen/*.cs" LinkBase="Product/WorldGen" />
    <Compile Include="$(ProductModules)Content/BlockId.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockDefinition.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockRegistry.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Terrain/TerrainConstants.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainConfiguration.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/VoxelAddress.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TreeFelling.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainOverlayState.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainOverlayCodec.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainEditPolicy.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Discovery/DiscoveryRules.cs" LinkBase="Product/Discovery" />
    <Compile Include="$(ProductModules)Discovery/DiscoveryState.cs" LinkBase="Product/Discovery" />
    <Compile Include="$(ProductModules)Discovery/DiscoveryCodec.cs" LinkBase="Product/Discovery" />
    <Compile Include="$(ProductModules)Places/HomeMarker.cs" LinkBase="Product/Places" />
    <Compile Include="$(ProductModules)Places/KnownPlaces.cs" LinkBase="Product/Places" />
    <Compile Include="$(ProductModules)Places/PlaceClusters.cs" LinkBase="Product/Places" />
    <Compile Include="$(ProductModules)Places/SledCodec.cs" LinkBase="Product/Places" />
    <Compile Include="$(ProductModules)Travel/Sled.cs" LinkBase="Product/Travel" />
    <Compile Include="$(ProductModules)Manipulation/BlockEntityIndex.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Manipulation/BlockEntityCodec.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Building/PieceCatalog.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/PlacedPiece.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/BuildPieceSet.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/BuildPieceCodec.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/PieceRemnant.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/RemnantSet.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/RemnantCodec.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Building/PieceSupport.cs" LinkBase="Product/Building" />
    <Compile Include="$(ProductModules)Player/PlayerContinuation.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Survival/WorldConditions.cs" LinkBase="Product/Survival" />
    <Compile Include="$(ProductModules)Survival/Difficulty.cs" LinkBase="Product/Survival" />
    <Compile Include="$(ProductModules)Survival/SurvivalRules.cs" LinkBase="Product/Survival" />
    <Compile Include="$(ProductModules)Survival/SurvivalCodec.cs" LinkBase="Product/Survival" />
    <Compile Include="$(ProductModules)Inventory/ItemCatalog.cs" LinkBase="Product/Inventory" />
    <Compile Include="$(ProductModules)Inventory/Recipes.cs" LinkBase="Product/Inventory" />
    <Compile Include="$(ProductModules)Inventory/InventoryCodec.cs" LinkBase="Product/Inventory" />
    <Compile Include="$(ProductModules)Inventory/InventorySlots.cs" LinkBase="Product/Inventory" />
    <Compile Include="$(ProductModules)Rpg/*.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Sky/WorldClock.cs" LinkBase="Product/Sky" />
    <Compile Include="$(ProductModules)Options/GameOptions.cs" LinkBase="Product/Options" />
  </ItemGroup>
</Project>
