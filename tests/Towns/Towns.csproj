<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <Compile Include="$(ProductModules)Towns/*.cs" Exclude="$(ProductModules)Towns/TownDebugModule.cs" LinkBase="Product/Towns" />
    <Compile Include="$(ProductModules)WorldGen/Settlement.cs;$(ProductModules)WorldGen/TownGround.cs;$(ProductModules)WorldGen/GenerationConstants.cs" LinkBase="Product/WorldGen" />
    <Compile Include="$(ProductModules)World/ProductIds.cs;$(ProductModules)World/WorldFrame.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/ProductUiPublisher.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/ProductUiProjection.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)Content/PropMesh.cs;$(ProductModules)Content/PropMaterials.cs;$(ProductModules)Content/SurfaceMoss.cs" LinkBase="Product/Content" />
    <None Include="../../content/game/towns/**/*" Link="Content/towns/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../content/game/models/scatter/fern-1.prop-mesh.json" Link="Content/models/scatter/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../content/game/textures/fire-smoke.png" Link="Content/textures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../content/game/textures/trees/fern-leaves.png" Link="Content/textures/trees/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
