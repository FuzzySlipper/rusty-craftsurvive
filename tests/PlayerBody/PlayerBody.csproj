<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The player's body against the Engine's own collision, run headless: the SDK records the
         pinned pair's test host library for a test project. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <Compile Include="$(ProductModules)Player/PlayerRecovery.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Player/PlayerBody.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Player/PlayerConstants.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)World/ProductIds.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)Terrain/TerrainConstants.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Content/BlockId.cs" LinkBase="Product/Content" />
  </ItemGroup>
</Project>
