<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- The RPG rules are pure product policy: they use no Engine type at all, and
         this lane links them directly so the arithmetic is checked without a host. -->
    <Compile Include="$(ProductModules)Rpg/CharacterRules.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/CombatRules.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/EncounterRules.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/EncounterPolicy.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/CreatureBehavior.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/EncounterResolution.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/EncounterDirector.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/PlayerDefeatRules.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/CreatureKinds.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/CharacterSheet.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/KeyedDraws.cs" LinkBase="Product/Rpg" />
    <!-- The creature step and roster are pure too; the world frame and step time are value
         conversions over Engine facts. -->
    <Compile Include="$(ProductModules)Creatures/CreatureRoster.cs" LinkBase="Product/Creatures" />
    <Compile Include="$(ProductModules)Creatures/CreatureSimulation.cs" LinkBase="Product/Creatures" />
    <Compile Include="$(ProductModules)Creatures/CreatureSpawnPlan.cs" LinkBase="Product/Creatures" />
    <Compile Include="$(ProductModules)Player/PlayerVitals.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)World/ProductStep.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)World/WorldFrame.cs" LinkBase="Product/World" />
    <!-- The world's clock is rules over a day fraction. -->
    <Compile Include="$(ProductModules)Sky/WorldClock.cs" LinkBase="Product/Sky" />
    <!-- Survival is rules over tracks and a difficulty. -->
    <Compile Include="$(ProductModules)Survival/SurvivalRules.cs" LinkBase="Product/Survival" />
    <Compile Include="$(ProductModules)Survival/Difficulty.cs" LinkBase="Product/Survival" />
    <!-- The climbing rule reads blocks through a lookup, so it is checked over a made-up wall. -->
    <Compile Include="$(ProductModules)Player/PlayerClimb.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Player/PlayerConstants.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)World/ProductIds.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)Content/BlockId.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockDefinition.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockRegistry.cs" LinkBase="Product/Content" />
  </ItemGroup>
</Project>
