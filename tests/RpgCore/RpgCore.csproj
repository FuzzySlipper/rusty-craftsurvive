<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- The RPG rules are pure product policy: they use no Engine type at all, and
         this lane links them directly so the arithmetic is checked without a host. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/CharacterRules.cs" Link="Rpg/CharacterRules.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/CombatRules.cs" Link="Rpg/CombatRules.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterRules.cs" Link="Rpg/EncounterRules.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterPolicy.cs" Link="Rpg/EncounterPolicy.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/CreatureBehavior.cs" Link="Rpg/CreatureBehavior.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterResolution.cs" Link="Rpg/EncounterResolution.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterDirector.cs" Link="Rpg/EncounterDirector.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/PlayerDefeatRules.cs" Link="Rpg/PlayerDefeatRules.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/CreatureKinds.cs" Link="Rpg/CreatureKinds.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/CharacterSheet.cs" Link="Rpg/CharacterSheet.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/KeyedDraws.cs" Link="Rpg/KeyedDraws.cs" />
    <!-- The creature step and roster are pure too; the world frame and step time are value
         conversions over Engine facts. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/Creatures/CreatureRoster.cs" Link="Creatures/CreatureRoster.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Creatures/CreatureSimulation.cs" Link="Creatures/CreatureSimulation.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Creatures/CreatureSpawnPlan.cs" Link="Creatures/CreatureSpawnPlan.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Player/PlayerVitals.cs" Link="Player/PlayerVitals.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/World/ProductStep.cs" Link="World/ProductStep.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/World/WorldFrame.cs" Link="World/WorldFrame.cs" />
  </ItemGroup>
</Project>
