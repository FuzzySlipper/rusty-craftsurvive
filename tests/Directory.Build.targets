<Project>
  <!-- Every managed lane compiles the one shared harness. A lane that links the generator also
       sets TestsUseGeneration and gets the one draw fake. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" LinkBase="Shared" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Generation/*.cs" LinkBase="Shared/Generation" Condition="'$(TestsUseGeneration)' == 'true'" />
  </ItemGroup>
</Project>
