<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- Pure product rules only; no alternative Engine host or binding. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainConstants.cs" Link="TerrainConstants.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Content/BlockId.cs" Link="Content/BlockId.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Content/BlockDefinition.cs" Link="Content/BlockDefinition.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Content/BlockRegistry.cs" Link="Content/BlockRegistry.cs" />
    <!-- The world generator is pure: link it whole. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/WorldGen/*.cs" LinkBase="WorldGen" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainChunkCache.cs" Link="Terrain/TerrainChunkCache.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainGenerationFingerprint.cs" Link="Terrain/TerrainGenerationFingerprint.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainConfiguration.cs" Link="TerrainConfiguration.cs" />
    <!-- The recipe places points of interest, so this lane links the placement policy it
         drives; the residency checks below cover chunks that hold a structure. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainChunk.cs" Link="TerrainChunk.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainResidencyPolicy.cs" Link="TerrainResidencyPolicy.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainOverlayState.cs" Link="TerrainOverlayState.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainEditPolicy.cs" Link="TerrainEditPolicy.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainEditTransaction.cs" Link="TerrainEditTransaction.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Manipulation/BlastPolicy.cs" Link="Manipulation/BlastPolicy.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Manipulation/BlastCharge.cs" Link="Manipulation/BlastCharge.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Manipulation/BlastDust.cs" Link="Manipulation/BlastDust.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Manipulation/BuildStamp.cs" Link="Manipulation/BuildStamp.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Manipulation/BlockEntityIndex.cs" Link="Manipulation/BlockEntityIndex.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/VoxelAddress.cs" Link="VoxelAddress.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Player/PlayerConstants.cs" Link="PlayerConstants.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/World/ProductIds.cs" Link="World/ProductIds.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Player/PlayerInputState.cs" Link="PlayerInputState.cs" />
    <!-- The encounter rules are pure policy, so the world facts can be checked against real terrain here. -->
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterRules.cs" Link="Rpg/EncounterRules.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Rpg/EncounterPolicy.cs" Link="Rpg/EncounterPolicy.cs" />
    <Compile Include="../../src/CraftSurvive.Game/Modules/Terrain/TerrainEncounterFacts.cs" Link="Terrain/TerrainEncounterFacts.cs" />
  </ItemGroup>
</Project>
