<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestsUseGeneration>true</TestsUseGeneration>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- Pure product rules only; no alternative Engine host or binding. -->
    <Compile Include="$(ProductModules)Terrain/TerrainConstants.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Content/BlockId.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockDefinition.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BlockRegistry.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)Content/BuildPalette.cs" LinkBase="Product/Content" />
    <!-- The world generator is pure: link it whole. -->
    <Compile Include="$(ProductModules)WorldGen/*.cs" LinkBase="Product/WorldGen" />
    <Compile Include="$(ProductModules)Terrain/TerrainChunkCache.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainGenerationFingerprint.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainConfiguration.cs" LinkBase="Product/Terrain" />
    <!-- The recipe places points of interest, so this lane links the placement policy it
         drives; the residency checks below cover chunks that hold a structure. -->
    <Compile Include="$(ProductModules)Terrain/TerrainChunk.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainResidencyPolicy.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainOverlayState.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainEditPolicy.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Terrain/TerrainEditTransaction.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Manipulation/BlastPolicy.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Manipulation/BlastCharge.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Manipulation/BlastDust.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Manipulation/BuildStamp.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Manipulation/BlockEntityIndex.cs" LinkBase="Product/Manipulation" />
    <Compile Include="$(ProductModules)Terrain/VoxelAddress.cs" LinkBase="Product/Terrain" />
    <Compile Include="$(ProductModules)Player/PlayerConstants.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Player/PlayerWorldPosition.cs" LinkBase="Product/Player" />
    <Compile Include="$(ProductModules)Actions/PlayerAction.cs" LinkBase="Product/Actions" />
    <Compile Include="$(ProductModules)Content/TerrainAtlasLayout.cs" LinkBase="Product/Content" />
    <Compile Include="$(ProductModules)World/ProductIds.cs" LinkBase="Product/World" />
    <Compile Include="$(ProductModules)Player/PlayerInputState.cs" LinkBase="Product/Player" />
    <!-- The encounter rules are pure policy, so the world facts can be checked against real terrain here. -->
    <Compile Include="$(ProductModules)Rpg/EncounterRules.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Rpg/EncounterPolicy.cs" LinkBase="Product/Rpg" />
    <Compile Include="$(ProductModules)Terrain/TerrainEncounterFacts.cs" LinkBase="Product/Terrain" />
  </ItemGroup>
</Project>
