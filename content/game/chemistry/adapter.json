// How CraftSurvive's world feeds the chemistry field around the player (#10293), and what the field may write
// back. Blocks not named take "default". Air below a water surface loads as "water".
{
  "pack": "chemistry/pack.json",
  "blocks": {
    "default": "stone",
    "Air": "air",
    "Grass": "grass",
    "DryGrass": "dry-grass",
    "BurntGround": "burnt-ground",
    "Dirt": "soil",
    "Sand": "soil",
    "Gravel": "soil",
    "Snow": "snow",
    "Water": "water",
    "Log": "wood",
    "Planks": "wood",
    "TreeCore": "wood"
  },
  "water": "water",
  // A cell that becomes one of these materials is written into the world as this block, but only while the
  // world still holds one of the blocks it came from there (a player's edit since then wins); and so is the cell
  // beneath it where that holds one of "beneath", so the smooth ground shows the block rather than a blend with it.
  "writeBack": [
    { "material": "burnt-ground", "block": "BurntGround", "over": ["Grass", "DryGrass"], "beneath": ["Dirt"] }
  ],
  // Each written cell takes one of the terrain overlay's 65,536 entries until its scar grows back. Fire writes only while the
  // overlay keeps this many free for the player's own edits. Writes are gathered and applied together every so
  // many seconds, at most this many cells at once, since each edit also refreshes residency and presentation.
  // A write's terrain edit costs the update about 25 ms whatever its size (#10384: residency and presentation), so
  // writes are few and full rather than small and frequent.
  "budget": { "keepFreeEntries": 32768, "cellsPerWrite": 256, "writeSeconds": 1 },
  // The field: chunk columns this far around the player's, the chunk holding each column's surface and the
  // one above it, loading at most this many chunks an update. Beside a burning column the field reaches this
  // much further, so a fire carries on past the window; beyond it, it stops at the field's edge.
  "field": { "reachChunks": 1, "burningReachChunks": 2, "loadsPerUpdate": 1, "stepSeconds": 0.1, "stepsPerUpdate": 2 },
  // The weather as ambient: air heat between warm and bitter by the Cold channel; Wind along the flow carries
  // heat and smoke at up to this many cells a second; Precipitation scales rain's wetting.
  "ambient": { "warmHeat": 22, "coldHeat": -12, "windCellsPerSecond": 0.8, "refreshSeconds": 2 },
  // Burning cells are shown as fire (#10296): each burning cell's ground, and over the nearest squares of this many
  // cells across, at most this many, a light and smoke. A cell that becomes "burnt" shows as cooling, then cold, char.
  "fires": { "materials": ["burning-grass"], "slots": 12, "clusterCells": 4, "burnt": "burnt-ground" },
  // A fire's scar (#10296; owner 2026-10-26: it grows back): ground written as this block grows back to what the
  // generator made there over this many days, each cell due from the earliest share of them, so a scar heals in
  // patches. Every so many seconds, at most this many due cells within this many metres of the player grow back;
  // each frees the overlay entry its burning took.
  "scars": { "block": "BurntGround", "regrowDays": 8, "earliest": 0.4, "healSeconds": 5, "cellsPerHeal": 256, "healReach": 160 }
}
