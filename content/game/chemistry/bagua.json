// The magic compiler's Bagua grammar for CraftSurvive's pack (#10529): every hexagram compiles into a formula
// by one rule (rusty-chemistry src/RustyChemistry/Casting/Bagua.cs). The lower trigram is the inner one, what acts:
// its "inner" effects name the kernel operator and the quantity. The upper trigram is the outer one, how it reaches
// the world: its "outer" delivery. The count of yang lines across both picks a "balance" entry that signs and
// scales the result: yin draws in and drains, yang adds and spreads. Lines are bottom first, 1 yang, 0 yin.
// Every effect and number is a PLACEHOLDER to play with, not a ruling: Patch's direction (atlas, 2026-11-01) is
// that relics may ship compiled formulas, while this grammar is the development compiler.
// Not here yet: lake as the kernel's confine operator, since a quantity blocked by a hold leaves the transfer's
// fast path for every chunk; lake pools water instead.
{
  "trigrams": {
    "heaven": { "lines": "111", "glyph": "☰", "name": "乾 Qian",
      // Radiance: a flash of heat that runs out over what it can cross.
      "inner": [{ "operator": "front", "quantity": "heat", "amount": 300 }],
      // Wide and far, slow to land.
      "outer": { "anchor": "above", "radius": 5, "strength": 0.6, "delay": 0.8, "reach": 20, "seconds": 3, "repeats": 1, "frontSpeed": 20 } },
    "earth": { "lines": "000", "glyph": "☷", "name": "坤 Kun",
      // Receiving: moves heat, water and smoke without adding any.
      "inner": [
        { "operator": "transfer", "quantity": "heat", "amount": 1 },
        { "operator": "transfer", "quantity": "moisture", "amount": 1 },
        { "operator": "transfer", "quantity": "smoke", "amount": 1 }
      ],
      // Close and strong, quick to land.
      "outer": { "anchor": "hit", "radius": 2, "strength": 1.6, "delay": 0.2, "reach": 6, "seconds": 4, "repeats": 1, "frontSpeed": 8 } },
    "fire": { "lines": "101", "glyph": "☲", "name": "離 Li",
      "inner": [{ "operator": "emit", "quantity": "heat", "amount": 2500 }],
      // Clinging: it stays on what it struck.
      "outer": { "anchor": "hit", "radius": 2, "strength": 1, "delay": 0.3, "reach": 8, "seconds": 3, "repeats": 1, "frontSpeed": 10 } },
    "water": { "lines": "010", "glyph": "☵", "name": "坎 Kan",
      "inner": [{ "operator": "emit", "quantity": "moisture", "amount": 1.5 }],
      // Flowing: it falls in pulses from in front of the struck face.
      "outer": { "anchor": "above", "radius": 3, "strength": 1, "delay": 0.5, "reach": 10, "seconds": 3, "repeats": 3, "frontSpeed": 6 } },
    "thunder": { "lines": "100", "glyph": "☳", "name": "震 Zhen",
      "inner": [{ "operator": "discharge", "quantity": "charge", "amount": 80, "minConductance": 0.5 }],
      // Arousing: at once, twice.
      "outer": { "anchor": "hit", "radius": 1.5, "strength": 1.5, "delay": 0, "reach": 6, "seconds": 0.6, "repeats": 2, "frontSpeed": 40 } },
    "wind": { "lines": "011", "glyph": "☴", "name": "巽 Xun",
      "inner": [{ "operator": "front", "quantity": "gust", "amount": 40 }],
      // Gentle and penetrating: far, light, in many waves, pushing outward.
      "outer": { "anchor": "above", "radius": 4, "strength": 0.5, "delay": 0.4, "reach": 24, "seconds": 6, "repeats": 4, "frontSpeed": 12, "gather": -0.5 } },
    "lake": { "lines": "110", "glyph": "☱", "name": "兌 Dui",
      // Pooling: a little water, and the water around drawn together.
      "inner": [
        { "operator": "emit", "quantity": "moisture", "amount": 0.6 },
        { "operator": "transfer", "quantity": "moisture", "amount": 1 }
      ],
      // Open and shallow, spreading over the surface.
      "outer": { "anchor": "above", "radius": 4, "strength": 0.8, "delay": 0.6, "reach": 12, "seconds": 5, "repeats": 1, "frontSpeed": 8 } },
    "mountain": { "lines": "001", "glyph": "☶", "name": "艮 Gen",
      // Binding: what it holds resists catching fire.
      "inner": [{ "operator": "emit", "quantity": "bind", "amount": 10 }],
      // Keeping still: small, long, drawn in.
      "outer": { "anchor": "hit", "radius": 2.5, "strength": 1.2, "delay": 0.6, "reach": 6, "seconds": 8, "repeats": 1, "frontSpeed": 6, "gather": 0.5 } }
  },
  // By count of yang lines, none to six.
  "balance": [
    { "label": "pure yin, drains and draws in", "rate": -1, "gather": 1, "strength": 0.4 },
    { "label": "yin, drains and draws in", "rate": -0.6, "gather": 0.6, "strength": 0.6 },
    { "label": "leaning yin, adds a little and draws in", "rate": 0.3, "gather": 0.3, "strength": 0.8 },
    { "label": "balanced, adds and holds still", "rate": 0.6, "gather": 0, "strength": 1 },
    { "label": "leaning yang, adds and spreads", "rate": 1, "gather": -0.3, "strength": 1.2 },
    { "label": "yang, adds strongly and spreads", "rate": 1.4, "gather": -0.6, "strength": 1.5 },
