<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The golden-seed exporter (#11125): generates the golden world with the product's own generator and the Engine's keyed
    draws (an Engine tool host, as the managed lanes run one), and writes every layer the CMS atlas shows. It compiles the
    product's sources as the WorldMap, Towns and DungeonBank lanes do; GoldenSeedSource.Stamp hashes them, so a cached tile
    is never served for different generator code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RustyEngineToolHost>true</RustyEngineToolHost>
    <RootNamespace>GoldenSeed</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <Compile Include="$(ProductModules)Content/BlockId.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Content/BlockDefinition.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Content/BlockRegistry.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Terrain/TerrainConstants.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Terrain/TerrainConfiguration.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Terrain/TerrainChunk.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Terrain/TerrainChunkCache.cs" LinkBase="Product" />
    <Compile Include="$(ProductModules)Terrain/VoxelAddress.cs" LinkBase="Product" />
