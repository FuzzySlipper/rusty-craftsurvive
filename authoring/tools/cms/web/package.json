{
  "name": "rusty-wandering-cms-web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && esbuild src/main.tsx --bundle --splitting --format=esm --target=es2022 --jsx=automatic --jsx-import-source=preact --minify --outdir=dist --entry-names=app",
    "watch": "esbuild src/main.tsx --bundle --splitting --format=esm --target=es2022 --jsx=automatic --jsx-import-source=preact --sourcemap --watch --outdir=dist --entry-names=app"
  },
  "dependencies": {
    "preact": "^10.26.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "esbuild": "^0.25.0",
    "typescript": "5.9.2"
  }
}
